# SPOT ワーカー用（サーバ専用・絶対に公開しない）。
# Supabase Studio → Project Settings → API から取得。
export SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# service_role キー（RLSを貫通する強力なキー。フロントやチャットには絶対に出さない）
export SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# Stripe Webhook（stripe_webhook.py 用・任意）。Stripe → Developers → Webhooks の署名シークレット。
export STRIPE_WEBHOOK_SECRET="whsec_YOUR-WEBHOOK-SIGNING-SECRET"

# 制作完了メール（任意）。Resend の API キーと差出人（ドメイン認証済みのアドレス）。未設定ならメールは送られない。
export RESEND_API_KEY="re_YOUR-RESEND-API-KEY"
export RESEND_FROM="Spot <no-reply@creativepunx.com>"
# メール内の「Spot を開く」リンク先（本番アプリの URL）
export APP_URL="https://app.spot.creativepunx.com/"   # 仮ドメイン。docs/hosting.md

# 台本ステージ（P4・任意）。--live で Claude に台本を書かせる。未設定ならテンプレート台本（フローは止まらない）。
export ANTHROPIC_API_KEY="sk-ant-YOUR-KEY"
# export SPOT_SCRIPT_MODEL="claude-opus-5-5"   # 既定
# 検品（review）も同じキーで Claude の画像判定を使う。未設定なら検品なしで通過。モデルは SPOT_REVIEW_MODEL（既定 claude-opus-5-5）
